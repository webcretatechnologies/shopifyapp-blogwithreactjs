{% schema %}
{
  "name": "Blog Analytics Tracker",
  "target": "head",
  "javascript": "tracker.js",
  "settings": []
}
{% endschema %}

{% comment %}
  Injected in <head> so listing CSS is render-blocking. A body <link> painted Dawn's
  collage first, then jumped to the app layout after /apps/blog-analytics/listing.css loaded.
{% endcomment %}
{% if template.name == 'blog' %}
  {% assign listing_layout = shop.metafields.blog_app.listing_layout.value | default: shop.metafields.blog_app.listing_layout %}
  {% comment %} Free plan stores "theme" so we leave the merchant's theme listing alone. {% endcomment %}
  {% if listing_layout != blank and listing_layout != 'theme' and listing_layout != 'default' %}
  {%- comment -%}
    Same selector set as listingGridSelector() in EditorContentCompiler.js, which serves
    /apps/blog-analytics/listing.css linked below. This block is the render-blocking half of
    that pair, so a narrower list here meant a non-Dawn theme painted its own layout first and
    only snapped to the app's once the proxy CSS arrived - the exact flash this <style> exists
    to prevent. Worse, .blog__posts appeared only in the base rule and in none of the layout
    rules, so those themes got display:grid with no grid-template-columns: a forced single
    column, worse than leaving the theme alone. :is() keeps the comma list from leaking
    properties onto the wrong node, per the theme-agnostic rule.

    Grid containers and listing items are kept separate on purpose: .article is the individual
    post wrapper on many vintage themes, not the list, so it belongs with .article-card rather
    than with the containers.
  {%- endcomment -%}
  {%- comment -%}
    .blog-posts-container / .blog-post-item / .blog-post-card cover Shopify's newer
    block-based ("Horizon"-family) theme, which spans columns via a --col-span custom
    property on .blog-post-item rather than grid-template-columns math. Its own inline
    per-item <style> only ever sets --col-span (never grid-column directly), so our
    !important grid-column reset below still wins regardless of that variable's value.
  {%- endcomment -%}
  {%- assign li_grid = ":is(.blog-articles, .blog-articles.blog-articles--collage, .blog__posts, .blog-list, .blog-post-list, .main-blog .blog-articles, ul.blog-articles, #MainContent .blog-articles, #MainContent .blog__posts, #MainContent .blog-list, .blog-posts-container)" -%}
  {%- assign li_collage = ".blog-articles--collage" -%}
  {%- assign li_item = ":is(.card.article-card, .article-card, .article)" -%}
  {%- comment -%}
    NEVER target the featured post with a bare :first-child. Themes are free to put
    non-rendered nodes (Shopify's own per-block <style data-shopify> tags, <script>,
    <template>) inside the grid container, and :first-child then matches one of THOSE —
    a display:none node — so the featured span silently lands on nothing and the layout
    looks identical to the theme's default. CSS has no portable "first rendered child"
    selector, so the script below stamps [data-blogger-listing-first] on the real first
    item and every featured rule matches either that or :first-child (which still gives
    themes with no interleaved nodes a correct first paint, with no flash).
  {%- endcomment -%}
  {%- assign li_first = ":is(*:first-child, [data-blogger-listing-first])" -%}
  <style id="blogger-listing-critical">
    {{ li_grid }} {
      display: grid !important;
      gap: 1.5rem !important;
      grid-auto-flow: row !important;
    }
    {{ li_grid }} > *,
    .blog-post-item {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    {{ li_collage }} > *,
    {{ li_collage }} > *:nth-child(3n + 1),
    {{ li_collage }} > *:nth-child(3n + 2):last-child {
      grid-column: auto !important;
    }
    {{ li_collage }} > *:nth-child(3n + 1) .ratio::before,
    {{ li_collage }} > *:nth-child(3n + 2):last-child .ratio::before {
      padding-bottom: var(--ratio-percent, 66.67%) !important;
    }
    {{ li_grid }} .media > img,
    {{ li_grid }} .card__media img,
    {{ li_grid }} .article-card__image img {
      object-fit: cover !important;
      object-position: center center !important;
    }
    {% if listing_layout == 'list' %}
    {{ li_grid }} { grid-template-columns: minmax(0, 1fr) !important; }
    {{ li_grid }} {{ li_item }}:has(.media img) {
      display: flex !important;
      flex-direction: row !important;
      align-items: stretch !important;
    }
    {{ li_grid }} {{ li_item }}:has(.media img) > .card__inner {
      flex: 0 0 32% !important;
      max-width: 280px !important;
      width: 32% !important;
    }
    {{ li_grid }} {{ li_item }}:has(.media img) > .card__content {
      flex: 1 1 auto !important;
      min-width: 0 !important;
    }
    {{ li_grid }} {{ li_item }}:has(.media img) > .card__inner > .card__content {
      display: none !important;
    }
    {{ li_grid }} .blog-post-card:has(.blog-post-card__image-container) {
      display: flex !important;
      flex-direction: row !important;
      align-items: stretch !important;
    }
    {{ li_grid }} .blog-post-card:has(.blog-post-card__image-container) > .blog-post-card__image-container {
      flex: 0 0 32% !important;
      max-width: 280px !important;
      width: 32% !important;
    }
    {{ li_grid }} .blog-post-card:has(.blog-post-card__image-container) > .blog-post-card__content {
      flex: 1 1 auto !important;
      min-width: 0 !important;
    }
    @media (max-width: 749px) {
      {{ li_grid }} {{ li_item }}:has(.media img) { flex-direction: column !important; }
      {{ li_grid }} {{ li_item }}:has(.media img) > .card__inner {
        flex: 0 0 auto !important;
        width: 100% !important;
        max-width: none !important;
      }
      {{ li_grid }} .blog-post-card:has(.blog-post-card__image-container) { flex-direction: column !important; }
      {{ li_grid }} .blog-post-card:has(.blog-post-card__image-container) > .blog-post-card__image-container {
        flex: 0 0 auto !important;
        width: 100% !important;
        max-width: none !important;
      }
    }
    {% elsif listing_layout == 'grid_3' %}
    {{ li_grid }} { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
    @media (max-width: 989px) {
      {{ li_grid }} { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    }
    @media (max-width: 749px) {
      {{ li_grid }} { grid-template-columns: minmax(0, 1fr) !important; }
    }
    {% elsif listing_layout == 'grid_2' %}
    {{ li_grid }} { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    @media (max-width: 749px) {
      {{ li_grid }} { grid-template-columns: minmax(0, 1fr) !important; }
    }
    {% elsif listing_layout == 'featured_2' %}
    {{ li_grid }} { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    @media (min-width: 750px) {
      {{ li_grid }} > {{ li_first }},
      {{ li_collage }} > {{ li_first }} { grid-column: 1 / -1 !important; }
    }
    @media (max-width: 749px) {
      {{ li_grid }} { grid-template-columns: minmax(0, 1fr) !important; }
    }
    {% elsif listing_layout == 'magazine' %}
    {{ li_grid }} { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
    {{ li_grid }} > {{ li_first }},
    {{ li_collage }} > {{ li_first }} {
      grid-column: 1 / span 2 !important;
    }
    @media (max-width: 989px) {
      {{ li_grid }} { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
      {{ li_grid }} > {{ li_first }} { grid-column: 1 / -1 !important; }
    }
    @media (max-width: 749px) {
      {{ li_grid }} { grid-template-columns: minmax(0, 1fr) !important; }
      {{ li_grid }} > {{ li_first }} { grid-column: auto !important; }
    }
    {% else %}
    {{ li_grid }} { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    {% endif %}
  </style>
  {%- comment -%}
    ?layout=<value> is pure cache-busting, never read by the server. listing.css is served
    with Cache-Control: max-age=30, stale-while-revalidate=60 — a merchant who saves a new
    layout and reloads within that window (very likely right after clicking Save) got the
    PREVIOUS layout's cached response with the old URL, looking identical to before the
    change. Keying the URL on the layout value gives each distinct layout its own cache
    entry, so switching layouts always fetches fresh while re-visiting an unchanged layout
    still hits cache.
  {%- endcomment -%}
  <link rel="stylesheet" href="/apps/blog-analytics/listing.css?layout={{ listing_layout | url_param_escape }}" fetchpriority="high">
  <script>
    (function () {
      // The critical <style> above (and listing.css) only ever target a hand-maintained list
      // of known theme class names — that list can NEVER cover every theme this app will be
      // installed on (App Store distribution, not one sandbox store). Per the theme-agnostic
      // rule, this block is the real fix, not another class name appended to the list above:
      // it finds the repeating post grid GENERICALLY, using the one thing every Shopify blog
      // theme is guaranteed to share — article links matching /blogs/<handle>/<article>/ —
      // rather than any theme's own class names. The static <style> above stays only as a
      // zero-flash fast path for the two theme families already confirmed against real
      // stores; every other theme is handled here, so a brand-new theme this app has never
      // seen still gets a working layout instead of silently doing nothing.
      var layout = {{ listing_layout | json }};
      var ARTICLE_PATH_RE = /^\/blogs\/[^\/]+\/[^\/]+\/?$/;
      var KNOWN_SELECTORS = [
        '.blog-articles', '.blog__posts', '.blog-list', '.blog-post-list',
        '.main-blog .blog-articles', 'ul.blog-articles',
        '#MainContent .blog-articles', '#MainContent .blog__posts', '#MainContent .blog-list',
        '.blog-posts-container'
      ];

      function articlePath(a) {
        try {
          var u = new URL(a.getAttribute('href'), window.location.href);
          if (!ARTICLE_PATH_RE.test(u.pathname)) return null;
          return u.pathname.replace(/\/$/, '');
        } catch (e) { return null; }
      }

      // Finds the repeating card grid from Shopify's own guaranteed article URL shape alone —
      // no theme class names required. Requires 2-60 cards sharing one direct parent, and that
      // parent's children to BE (mostly) those cards, so it can't latch onto an unrelated
      // "related posts" widget or a footer link list a few levels away.
      function detectListingContainer() {
        var root = document.querySelector('#MainContent') || document.querySelector('main') || document.body;
        var byPath = {};
        var anchors = root.querySelectorAll('a[href]');
        for (var i = 0; i < anchors.length; i++) {
          var a = anchors[i];
          var p = articlePath(a);
          if (!p) continue;
          // Prefer the outer-most link for a given article (a card's title link usually wraps
          // more of the card than a nested "Read more" link to the same article).
          var cur = byPath[p];
          if (!cur || (cur.compareDocumentPosition(a) & Node.DOCUMENT_POSITION_CONTAINS)) {
            byPath[p] = a;
          }
        }
        var paths = Object.keys(byPath);
        if (paths.length < 2 || paths.length > 60) return null;
        var links = paths.map(function (p) { return byPath[p]; });

        function cardRoot(link) {
          var el = link;
          for (var depth = 0; depth < 8; depth++) {
            var parent = el.parentElement;
            if (!parent || parent === root) break;
            var innerAnchors = parent.querySelectorAll('a[href]');
            var articleLinkCount = 0;
            for (var j = 0; j < innerAnchors.length; j++) {
              if (articlePath(innerAnchors[j])) articleLinkCount++;
            }
            if (articleLinkCount > 1) break; // parent already spans more than one card - stop here
            el = parent;
          }
          return el;
        }

        var cards = links.map(cardRoot);
        var container = cards[0] && cards[0].parentElement;
        if (!container) return null;
        var allSameParent = cards.every(function (c) { return c.parentElement === container; });
        if (!allSameParent) return null;

        var directChildren = Array.prototype.slice.call(container.children);
        var matchedChildren = directChildren.filter(function (c) { return cards.indexOf(c) !== -1; });
        if (matchedChildren.length < 2 || matchedChildren.length < directChildren.length * 0.6) return null;

        return { container: container, items: matchedChildren };
      }

      function important(el, prop, val) { el.style.setProperty(prop, val, 'important'); }

      // Layout-only, same rules as the known-theme CSS above: grid columns + featured-item
      // span. No restyling of theme chrome (colors/fonts/card skins untouched).
      function applyGenericLayout(detected, layoutValue) {
        var container = detected.container;
        var items = detected.items;
        important(container, 'display', 'grid');
        important(container, 'gap', '1.5rem');
        items.forEach(function (it) {
          important(it, 'grid-column', 'auto');
          important(it, 'grid-row', 'auto');
        });
        var first = items[0];
        var wide = window.innerWidth >= 750;

        function cols(n) { important(container, 'grid-template-columns', 'repeat(' + n + ', minmax(0, 1fr))'); }

        if (!wide) {
          cols(1);
          return;
        }
        if (layoutValue === 'grid_3') cols(3);
        else if (layoutValue === 'list') cols(1);
        else if (layoutValue === 'magazine') {
          cols(3);
          important(first, 'grid-column', '1 / span 2');
        } else {
          // grid_2 and featured_2 share the same base grid; featured_2 additionally spans post 1.
          cols(2);
          if (layoutValue === 'featured_2') important(first, 'grid-column', '1 / -1');
        }
      }

      function report(matched, matchedSelector) {
        var sessionKey = 'blogger_listing_diag_sent:' + layout;
        try {
          if (sessionStorage.getItem(sessionKey)) return;
          sessionStorage.setItem(sessionKey, '1');
        } catch (e) {}
        fetch('/apps/blog-analytics/listing-diagnostic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ layout: layout, matched: matched, matchedSelector: matchedSelector }),
          keepalive: true
        }).catch(function () {});
      }

      // Stamps the first RENDERED child of each known grid container, so the featured-post
      // rules can't land on an interleaved <style>/<script> node (see the li_first comment).
      function markFirstRendered() {
        var containers = document.querySelectorAll(KNOWN_SELECTORS.join(','));
        Array.prototype.forEach.call(containers, function (container) {
          var marked = false;
          Array.prototype.forEach.call(container.children, function (child) {
            if (marked) { child.removeAttribute('data-blogger-listing-first'); return; }
            if (getComputedStyle(child).display === 'none') return;
            child.setAttribute('data-blogger-listing-first', '');
            marked = true;
          });
        });
      }

      function run() {
        var knownMatch = null;
        for (var i = 0; i < KNOWN_SELECTORS.length; i++) {
          try {
            if (document.querySelector(KNOWN_SELECTORS[i])) { knownMatch = KNOWN_SELECTORS[i]; break; }
          } catch (e) {}
        }
        // A known selector matched: the static <style> above already applied the right CSS,
        // but it still needs the real first item stamped for the featured layouts.
        if (knownMatch) {
          try { markFirstRendered(); } catch (e) {}
          report(true, knownMatch);
          return;
        }

        var detected = null;
        try { detected = detectListingContainer(); } catch (e) { detected = null; }
        if (detected) {
          try { applyGenericLayout(detected, layout); } catch (e) {}
          window.addEventListener('resize', function () {
            try { applyGenericLayout(detected, layout); } catch (e) {}
          });
          report(true, '(generic-detected)');
          return;
        }

        // Neither path found anything to style. Leave the theme's own listing exactly as-is
        // and report the miss so it surfaces as a warning in Settings for follow-up.
        report(false, null);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    })();
  </script>
  {% endif %}
{% endif %}

<script>
  window.BloggerAnalytics = window.BloggerAnalytics || {};
  window.BloggerAnalytics.shop = "{{ shop.permanent_domain }}";
  window.BloggerAnalytics.template = "{{ template.name }}";

  {% if article %}
    window.BloggerAnalytics.articleId = "{{ article.id }}";
  {% endif %}

  {% if product %}
    window.BloggerAnalytics.productId = "{{ product.id }}";
  {% endif %}
</script>

{% comment %}
  Article live features (sidebar + related posts) are loaded from the app proxy so
  Shopify's admin article editor cannot strip the script tags out of body_html.
  Safe to run twice with the body_html fallback scripts (each script no-ops on a second init).
{% endcomment %}
{% if template.name == 'article' or request.page_type == 'article' %}
<script src="/apps/blog-analytics/sidebar.js" defer></script>
<script src="/apps/blog-analytics/related-posts.js" defer></script>
{% endif %}

{% if template.name == 'blog' %}
<script>
  (function () {
    var months = "January|February|March|April|May|June|July|August|September|October|November|December";
    var re = new RegExp(
      "^By\\s+[\\s\\S]*?(?:" + months + ")\\s+\\d{1,2},\\s*\\d{4}\\s*\\d+\\s*min read\\s*",
      "i"
    );
    function cleanExcerpt(el) {
      var t = (el.textContent || "").replace(/^\s+/, "");
      t = t.replace(re, "");
      t = t.replace(/^Table of Contents\s+/i, "");
      el.textContent = t.replace(/^\s+/, "");
    }
    function run() {
      document.querySelectorAll(
        ".article-card__excerpt, .blog-articles .rte, .blog-articles .article-card .rte"
      ).forEach(cleanExcerpt);
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run);
    else run();
  })();
</script>
{% endif %}
