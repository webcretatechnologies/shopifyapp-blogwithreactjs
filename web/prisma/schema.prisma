generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  accountOwner        Boolean   @default(false)
  collaborator        Boolean?  @default(false)
  email               String?
  emailVerified       Boolean?  @default(false)
  firstName           String?
  lastName            String?
  locale              String?
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            Int           @id @default(autoincrement())
  domain        String        @unique
  accessToken   String        @db.Text
  planKey       String        @default("free")
  timezone      String?
  /** Lifetime AI generations consumed. Deliberately never reset: the plan's ai_credits is a
      one-off allowance, not a monthly quota, so this only ever counts up. */
  aiCreditsUsed Int           @default(0)
  /** Lifetime total AI generations bought via one-time AppPurchaseOneTime credit packs. Only ever
      incremented by the app_purchases_one_time/update webhook once Shopify confirms the charge
      is ACTIVE, never optimistically on checkout redirect. Never decremented - it's a purchase
      record, not a live balance (aiCreditsPurchasedUsed tracks how much of it has been spent). */
  aiCreditsPurchased Int      @default(0)
  /** How many of aiCreditsPurchased have actually been spent, tracked separately from
      aiCreditsUsed (which counts EVERY generation, plan-funded or purchased-funded) so that
      purchased credits stay usable on their own after a plan downgrade shrinks the plan's own
      ai_credits allowance below the shop's lifetime usage - see getAiCreditStatus. A generation
      only draws from the purchased pool (incrementing this) once the plan's own allowance for the
      CURRENT plan is exhausted; see AiGenerationJob.creditSource for which pool paid for a given
      job, so a refund reverses the correct one. */
  aiCreditsPurchasedUsed Int @default(0)
  installedAt   DateTime      @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appPlans      AppPlan[]
  categories    Category[]
  feedbacks     Feedback[]
  posts         Post[]
  products      Product[]
  settings      ShopSetting[]
  storeLogs     StoreLog[]
  tags          Tag[]
  templates     Template[]
  webhookLogs   WebhookLog[]
  processedOrderWebhooks ProcessedOrderWebhook[]
  aiJobs        AiGenerationJob[]
  aiCreditPurchases AiCreditPurchase[]
}

model AppPlan {
  id           Int      @id @default(autoincrement())
  shopId       Int
  planKey      String
  articleLimit Int?
  sectionLimit Int?
  features     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model PlanFeature {
  id         Int     @id @default(autoincrement())
  plan       String
  featureKey String
  enabled    Boolean @default(true)
  limit      Int?

  @@unique([plan, featureKey])
  @@index([plan])
}

model ShopSetting {
  id        Int      @id @default(autoincrement())
  shopId    Int
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
  @@index([shopId])
}

model Category {
  id        Int      @id @default(autoincrement())
  shopId    Int
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@unique([shopId, slug])
  @@index([shopId])
}

model Tag {
  id        Int       @id @default(autoincrement())
  shopId    Int
  name      String
  slug      String
  createdAt DateTime  @default(now())
  posts     PostTag[]
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, slug])
  @@index([shopId])
}

model Post {
  id                    Int               @id @default(autoincrement())
  shopId                Int
  categoryId            Int?
  /** Shopify blog selected before publish (ShopifyArticle doesn't exist yet); publish reads this if the merchant didn't change it. */
  blogId                String?
  /** Set when an AI generation for this post degraded to filler text (Groq unavailable/failed).
      Cleared on the post's next manual save, since that's the merchant reviewing it. */
  aiWarning             String?           @db.VarChar(500)
  /** Set true when an AI generation finishes writing this post's content. The editor uses it to
      silently re-save once on first open (so the client's own normalization - block ids, merged
      defaults - becomes the stored version before the merchant ever sees an unsaved-changes bar
      on a post they never touched) and clears it on that save, same as any other save would. */
  needsAutoSave         Boolean           @default(false)
  title                 String
  slug                  String
  status                String            @default("draft")
  author                String?
  vendor                String?
  excerpt               String?           @db.Text
  featuredImage         String?           @db.Text
  featuredImageAlt      String?           @db.Text
  contentJson           Json?
  contentHtml           String?           @db.LongText
  customCss             String?           @db.Text
  customJs              String?           @db.Text
  productSliderPosition String            @default("none")
  productSliderSource   String            @default("recommendations")
  productSliderConfig   Json?
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  canonicalUrl          String?           @db.Text
  editorMode            String            @default("wysiwyg")
  metaDescription       String?           @db.Text
  metaTitle             String?           @db.VarChar(120)
  ogDescription         String?           @db.Text
  ogImage               String?           @db.Text
  ogTitle               String?           @db.VarChar(120)
  metaRobotsNoindex     Boolean           @default(false)
  metaRobotsNofollow    Boolean           @default(false)
  excludeFromSitemap    Boolean           @default(false)
  richSnippetType       String            @default("BlogPosting")
  richSnippetData       Json?
  trackingKey           String?           @unique
  /** Related posts source override: inherit | smart | category | random | manual. Null = inherit shop default. */
  relatedPostsSourceMode String?
  /** Per-post sidebar override: inherit | on | off. Null = inherit shop default. */
  blogSidebarOverride   String?
  category              Category?         @relation(fields: [categoryId], references: [id])
  shop                  Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  analytics             PostAnalytic[]
  analyticsVisitors     AnalyticsVisitor[]
  blocks                PostBlock[]
  products              PostProduct[]
  tags                  PostTag[]
  translations          PostTranslation[]
  shopifyArticle        ShopifyArticle?
  relatedPosts          PostRelatedPost[] @relation("PostRelations")
  relatedByPosts        PostRelatedPost[] @relation("PostRelatedBy")

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, categoryId])
  @@index([categoryId], map: "Post_categoryId_fkey")
}

model PostTranslation {
  id              Int      @id @default(autoincrement())
  postId          Int
  locale          String
  title           String?
  excerpt         String?  @db.Text
  contentHtml     String?  @db.LongText
  metaTitle       String?  @db.VarChar(120)
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([postId])
}

model PostBlock {
  id         Int    @id @default(autoincrement())
  postId     Int
  blockType  String
  orderIndex Int    @default(0)
  settings   Json?
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId], map: "PostTag_tagId_fkey")
}

model Product {
  id               Int           @id @default(autoincrement())
  shopId           Int
  shopifyProductId String        @unique
  title            String
  handle           String
  image            String?       @db.Text
  price            Float?
  compareAtPrice   Float?
  variantId        String?
  variantAvailable Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  posts            PostProduct[]
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopifyProductId])
}

model PostProduct {
  postId    Int
  productId Int
  position  Int     @default(0)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([postId])
  @@index([productId], map: "PostProduct_productId_fkey")
}

model PostRelatedPost {
  postId        Int
  relatedPostId Int
  position      Int  @default(0)
  post          Post @relation("PostRelations", fields: [postId], references: [id], onDelete: Cascade)
  relatedPost   Post @relation("PostRelatedBy", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@id([postId, relatedPostId])
  @@index([postId])
  @@index([relatedPostId])
}

model ShopifyArticle {
  id                 Int       @id @default(autoincrement())
  postId             Int       @unique
  shopifyArticleId   String?   @unique
  shopifyBlogId      String?
  status             String    @default("draft")
  syncedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Sync tracking
  syncState          String    @default("linked") // linked | in_sync | pending_app_push | pending_shopify_pull | conflict | error | external_edit | remote_missing
  syncMode           String    @default("external_html") // external_html | managed_by_app
  lastSyncDirection  String?   // app_to_shopify | shopify_to_app
  lastSourceHash     String?   // hash of canonical app source
  lastOutboundHash   String?   // hash of exact payload pushed to Shopify (echo suppression)
  lastInboundHash    String?   // hash of last webhook payload applied
  lastRemoteUpdatedAt DateTime?
  lastError          String?   @db.Text
  structureDegraded  Boolean   @default(false)
  sourceMetafieldId  String?   // ID of the Shopify metafield storing editor source data

  // Baseline-based 2-way sync (field-level three-way merge)
  syncRevision        Int       @default(0)
  lastSyncedSnapshot  Json?     // Baseline snapshot with per-field values + hashes for 3-way merge
  conflictPayload     Json?     // Per-field conflict data when only some fields conflict

  post               Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([shopifyArticleId])
}

model ArticleSyncLog {
  id               Int      @id @default(autoincrement())
  shopId           Int
  postId           Int?
  shopifyArticleId String?
  direction        String   // app_to_shopify | shopify_to_app | reconcile
  eventType        String   // create | update | delete | publish | unpublish | webhook
  status           String   // applied | skipped_echo | skipped_duplicate | conflict | error
  message          String?  @db.Text
  localHash        String?
  remoteHash       String?
  payload          Json?
  createdAt        DateTime  @default(now())

  @@index([shopId])
  @@index([postId])
  @@index([createdAt])
}

model Template {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  thumbnail   String?
  blocks      Json
  source      String   @default("template") // "template" | "pattern" | "shop"
  shopId      Int?
  isActive    Boolean  @default(true)
  accent      String?
  category    String?
  preview     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([source])
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  shopId    Int
  topic     String
  payload   Json?
  status    String   @default("received")
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([topic])
}

model PostAnalytic {
  id              Int      @id @default(autoincrement())
  postId          Int
  views           Int      @default(0)
  uniqueVisitors  Int      @default(0)
  addToCart       Int      @default(0)
  checkouts       Int      @default(0)
  conversions     Int      @default(0)
  revenue         Float    @default(0)
  // revenueUsd is the sum of each individual conversion's amount already converted to USD at
  // write-time (via ExchangeRateService) — safe to sum across shops/currencies. `revenue` stays
  // the raw (mixed-currency) total, kept for per-shop display where the shop's own currency is
  // known from context. lastCurrency is the most recently seen order currency for this
  // post/day, informational only — never used in aggregation math.
  revenueUsd      Float    @default(0)
  lastCurrency    String?
  deviceDesktop   Int      @default(0)
  deviceMobile    Int      @default(0)
  deviceTablet    Int      @default(0)
  sources         Json?
  countries       Json?
  date            DateTime @db.Date
  createdAt       DateTime @default(now())

  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date])
  @@index([postId])
  @@index([date])
}

// Persists the per-post-per-day unique-visitor dedup that used to live only in an in-process
// Map (global.__trackedVisitors) — that reset on every restart/deploy and couldn't be shared
// across horizontally-scaled instances, silently inflating "unique visitors" in production.
// A row existing for (postId, date, visitorHash) means that visitor was already counted that day.
model AnalyticsVisitor {
  id          Int      @id @default(autoincrement())
  postId      Int
  date        DateTime @db.Date
  visitorHash String
  createdAt   DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date, visitorHash])
  @@index([postId, date])
}

// Idempotency guard for the orders/create webhook (server-side conversion tracking) — Shopify
// webhook delivery is at-least-once, so the same order can be redelivered after a timeout or a
// transient non-2xx response. Insert-then-catch-P2002 before processing, same pattern already
// used for AnalyticsVisitor/PostAnalytic writes above.
model ProcessedOrderWebhook {
  id        Int      @id @default(autoincrement())
  shopId    Int
  orderId   String
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  shopId    Int
  rating    Int?
  topic     String?  @db.VarChar(120)
  message   String   @db.Text
  page      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model StoreLog {
  id        Int      @id @default(autoincrement())
  shopId    Int
  log       String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  recipientEmail  String
  recipientDomain String?
  subject         String
  body            String?  @db.Text
  template        String?
  status          String   @default("sent")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminActivityLog {
  id         Int      @id @default(autoincrement())
  action     String
  targetType String?
  targetId   Int?
  meta       Json?
  createdAt  DateTime @default(now())
}

model AdminSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopPlanOverride {
  id           Int       @id @default(autoincrement())
  shopDomain   String    @unique
  overridePlan String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SubscriptionPlan {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  title       String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  interval    String   @default("EVERY_30_DAYS")
  trialDays   Int      @default(0)
  description String?  @db.Text
  features    Json?
  isActive    Boolean  @default(true)
  /// Shows the "Recommended" badge on the merchant billing page (frontend/pages/plans.jsx).
  /// Super Admin-controlled (EditPlanCoreModal's "Recommend / Highlight Plan in UI" checkbox) -
  /// previously this was hardcoded client-side to whichever plan had the highest price, which
  /// wasn't actually configurable from the admin panel.
  isRecommended Boolean @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  couponPlans CouponPlan[]
}

// ── Billing Coupons — SaaS subscription discount codes ─────────────────────
// Applied to a merchant's subscription to THIS app via Shopify's real Billing API
// (appSubscriptionCreate's discount field), not a storefront/customer discount. A discount can
// only ever be attached at appSubscriptionCreate time — Shopify's own billing engine owns the
// discount's clock after that, so there is no "edit a live subscription's discount" concept here.
model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(40)
  discountType   String   @default("PERCENTAGE") @db.VarChar(20) // PERCENTAGE | FIXED_AMOUNT
  percentOff     Decimal? @db.Decimal(5, 2)
  amountOff      Decimal? @db.Decimal(10, 2)
  durationMonths Int
  description    String?  @db.Text
  active         Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  totalUses      Int?                                               // null = unlimited
  usesPerStore   Int      @default(1)
  appliesTo      String   @default("ALL_PAID_PLANS") @db.VarChar(20) // ALL_PAID_PLANS | SPECIFIC_PLANS | SPECIFIC_STORES
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  plans          CouponPlan[]
  shops          CouponShop[]
  claims         CouponClaim[]
}

model CouponPlan {
  id       Int              @id @default(autoincrement())
  couponId Int
  coupon   Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  planId   Int
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([couponId, planId])
}

model CouponShop {
  id         Int    @id @default(autoincrement())
  couponId   Int
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  shopDomain String

  @@unique([couponId, shopDomain])
}

model CouponClaim {
  id                  Int      @id @default(autoincrement())
  couponId            Int?
  coupon              Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // Snapshot of the coupon's code at claim time — CouponsModule.jsx's own delete-confirmation
  // copy already promises "those merchants keep their existing discount; this only stops new
  // claims", i.e. deleting a Coupon definition was always meant to leave claim history intact,
  // not destroy it. couponId alone can't do that (once the Coupon row is gone, `coupon.code`
  // becomes unreachable through the relation) — this field is what actually lets the admin
  // panel's usage table keep showing which code was used after the coupon itself is deleted.
  couponCode          String   @db.VarChar(40)
  // Same reasoning as couponCode — durationMonths is read from the live coupon relation
  // (superAdmin.js's usage listing) to compute total discounted revenue and when a claim's
  // discount period ends. Snapshotting it here means that calculation still works correctly for
  // claims whose coupon has since been deleted, instead of throwing on a null relation.
  couponDurationMonths Int
  shopDomain          String
  planTier            String   // SubscriptionPlan.name, matching how Shop.planKey is stored
  priceBeforeDiscount Decimal  @db.Decimal(10, 2)
  discountedPrice     Decimal  @db.Decimal(10, 2)
  currencyCode        String   @db.VarChar(10)
  status              String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | DECLINED | CANCELLED | EXPIRED
  shopifyChargeId     String   @unique
  createdAt           DateTime @default(now())

  @@index([shopDomain])
  @@index([couponId])
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   @db.Text
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One AI article generation. The post row is created up-front as a draft so the list page has
/// something to show a progress bar against, and the job carries the stage/percent the poller
/// renders. Kept separate from Post so a failed or abandoned generation never leaves stage text
/// stranded on a real article.
model AiGenerationJob {
  id          Int       @id @default(autoincrement())
  shopId      Int
  postId      Int?
  status      String    @default("queued")
  /// Merchant-facing stage label, e.g. "Reading your brief".
  stage       String    @default("Queued")
  progress    Int       @default(0)
  /// The wizard's brief: template key, topic text, linked products, colour overrides.
  params      Json?
  /// Which pool this job's 1 credit was spent from at creation time - "plan" (the shop's own
  /// ai_credits allowance) or "purchased" (a one-time AiCreditPurchase pack), decided by
  /// getAiCreditStatus's nextCreditSource. A refund (runJob's refundAiCredit) reads this back to
  /// decrement the SAME counter that was incremented, so a downgrade that shrinks the plan's own
  /// allowance can never misattribute a refund to the wrong pool.
  creditSource String   @default("plan")
  error       String?   @db.Text
  /// Set when the job finished "done" but degraded to filler text (Groq unavailable/failed) -
  /// the draft still needs a human pass before publishing, unlike a normal successful run.
  warning     String?   @db.VarChar(500)
  /// True once refundAiCredit actually decremented the shop's usage back down for this job (a
  /// degraded/fallback "done" result, or a genuine "failed" one) - read by GET /api/ai/jobs so
  /// the list page can tell the merchant their credit was given back, not just that something
  /// went wrong. Stays false for a normal successful run, and for the (should-never-happen) case
  /// where the refund query's own gt:0 guard found nothing left to refund.
  creditRefunded Boolean @default(false)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
  @@index([postId])
}

/// A sellable AI-credit top-up pack (Super Admin's Pricing module manages these, mirroring
/// SubscriptionPlan). `key` is the stable identifier AiCreditPurchase.packKey snapshots at
/// purchase time and Shopify's appPurchaseOneTimeCreate `name` is derived from - renaming `key`
/// after purchases exist would orphan their historical label, so the admin UI should treat it as
/// effectively immutable once anything has been sold under it (price/credits/active are safe to
/// edit any time; only future purchases see the new values).
model AiCreditPack {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  credits    Int
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("USD")
  isActive   Boolean  @default(true)
  /// Shows the "Best value" badge on the merchant billing page's credit-pack tiles
  /// (frontend/pages/plans.jsx). Super Admin-controlled, same pattern as SubscriptionPlan's
  /// isRecommended - previously this was auto-computed client-side (lowest price-per-credit),
  /// which wasn't configurable from the admin panel.
  isRecommended Boolean @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One AI-credit top-up purchase - a Shopify AppPurchaseOneTime charge (not a recurring
/// subscription), bought when a shop wants more generations than their plan's ai_credits
/// allowance without changing plans. Created PENDING the moment appPurchaseOneTimeCreate returns
/// a confirmationUrl; only flips to APPROVED - and only then credits Shop.aiCreditsPurchased -
/// once the app_purchases_one_time/update webhook confirms Shopify's own ACTIVE status. Never
/// credited optimistically on the merchant's redirect back into the app, since that fires
/// whether they approved or declined Shopify's own confirmation screen.
model AiCreditPurchase {
  id                Int      @id @default(autoincrement())
  shopId            Int
  /// Key into AI_CREDIT_PACKS (src/services/AiCreditPackService.js), e.g. "small"/"medium"/"large".
  packKey           String
  credits           Int
  price             Decimal  @db.Decimal(10, 2)
  currencyCode      String   @db.VarChar(10)
  status            String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | DECLINED | CANCELLED | EXPIRED
  shopifyPurchaseId String   @unique
  test              Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
}
