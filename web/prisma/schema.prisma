generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  accountOwner        Boolean   @default(false)
  collaborator        Boolean?  @default(false)
  email               String?
  emailVerified       Boolean?  @default(false)
  firstName           String?
  lastName            String?
  locale              String?
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            Int           @id @default(autoincrement())
  domain        String        @unique
  accessToken   String        @db.Text
  planKey       String        @default("free")
  timezone      String?
  installedAt   DateTime      @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appPlans      AppPlan[]
  categories    Category[]
  feedbacks     Feedback[]
  posts         Post[]
  products      Product[]
  settings      ShopSetting[]
  storeLogs     StoreLog[]
  tags          Tag[]
  templates     Template[]
  webhookLogs   WebhookLog[]
  processedOrderWebhooks ProcessedOrderWebhook[]
}

model AppPlan {
  id           Int      @id @default(autoincrement())
  shopId       Int
  planKey      String
  articleLimit Int?
  sectionLimit Int?
  features     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model PlanFeature {
  id         Int     @id @default(autoincrement())
  plan       String
  featureKey String
  enabled    Boolean @default(true)
  limit      Int?

  @@unique([plan, featureKey])
  @@index([plan])
}

model ShopSetting {
  id        Int      @id @default(autoincrement())
  shopId    Int
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
  @@index([shopId])
}

model Category {
  id        Int      @id @default(autoincrement())
  shopId    Int
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@unique([shopId, slug])
  @@index([shopId])
}

model Tag {
  id        Int       @id @default(autoincrement())
  shopId    Int
  name      String
  slug      String
  createdAt DateTime  @default(now())
  posts     PostTag[]
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, slug])
  @@index([shopId])
}

model Post {
  id                    Int               @id @default(autoincrement())
  shopId                Int
  categoryId            Int?
  title                 String
  slug                  String
  status                String            @default("draft")
  author                String?
  vendor                String?
  excerpt               String?           @db.Text
  featuredImage         String?           @db.Text
  featuredImageAlt      String?           @db.Text
  contentJson           Json?
  contentHtml           String?           @db.LongText
  customCss             String?           @db.Text
  customJs              String?           @db.Text
  productSliderPosition String            @default("none")
  productSliderSource   String            @default("recommendations")
  productSliderConfig   Json?
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  canonicalUrl          String?           @db.Text
  editorMode            String            @default("wysiwyg")
  metaDescription       String?           @db.Text
  metaTitle             String?           @db.VarChar(120)
  ogDescription         String?           @db.Text
  ogImage               String?           @db.Text
  ogTitle               String?           @db.VarChar(120)
  metaRobotsNoindex     Boolean           @default(false)
  metaRobotsNofollow    Boolean           @default(false)
  excludeFromSitemap    Boolean           @default(false)
  richSnippetType       String            @default("BlogPosting")
  trackingKey           String?           @unique
  category              Category?         @relation(fields: [categoryId], references: [id])
  shop                  Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  analytics             PostAnalytic[]
  analyticsVisitors     AnalyticsVisitor[]
  blocks                PostBlock[]
  products              PostProduct[]
  tags                  PostTag[]
  translations          PostTranslation[]
  shopifyArticle        ShopifyArticle?
  relatedPosts          PostRelatedPost[] @relation("PostRelations")
  relatedByPosts        PostRelatedPost[] @relation("PostRelatedBy")

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, categoryId])
  @@index([categoryId], map: "Post_categoryId_fkey")
}

model PostTranslation {
  id              Int      @id @default(autoincrement())
  postId          Int
  locale          String
  title           String?
  excerpt         String?  @db.Text
  contentHtml     String?  @db.LongText
  metaTitle       String?  @db.VarChar(120)
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([postId])
}

model PostBlock {
  id         Int    @id @default(autoincrement())
  postId     Int
  blockType  String
  orderIndex Int    @default(0)
  settings   Json?
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId], map: "PostTag_tagId_fkey")
}

model Product {
  id               Int           @id @default(autoincrement())
  shopId           Int
  shopifyProductId String        @unique
  title            String
  handle           String
  image            String?       @db.Text
  price            Float?
  compareAtPrice   Float?
  variantId        String?
  variantAvailable Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  posts            PostProduct[]
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopifyProductId])
}

model PostProduct {
  postId    Int
  productId Int
  position  Int     @default(0)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([postId])
  @@index([productId], map: "PostProduct_productId_fkey")
}

model PostRelatedPost {
  postId        Int
  relatedPostId Int
  position      Int  @default(0)
  post          Post @relation("PostRelations", fields: [postId], references: [id], onDelete: Cascade)
  relatedPost   Post @relation("PostRelatedBy", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@id([postId, relatedPostId])
  @@index([postId])
  @@index([relatedPostId])
}

model ShopifyArticle {
  id                 Int       @id @default(autoincrement())
  postId             Int       @unique
  shopifyArticleId   String?   @unique
  shopifyBlogId      String?
  status             String    @default("draft")
  syncedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Sync tracking
  syncState          String    @default("linked") // linked | in_sync | pending_app_push | pending_shopify_pull | conflict | error | external_edit | remote_missing
  syncMode           String    @default("external_html") // external_html | managed_by_app
  lastSyncDirection  String?   // app_to_shopify | shopify_to_app
  lastSourceHash     String?   // hash of canonical app source
  lastOutboundHash   String?   // hash of exact payload pushed to Shopify (echo suppression)
  lastInboundHash    String?   // hash of last webhook payload applied
  lastRemoteUpdatedAt DateTime?
  lastError          String?   @db.Text
  structureDegraded  Boolean   @default(false)
  sourceMetafieldId  String?   // ID of the Shopify metafield storing editor source data

  // Baseline-based 2-way sync (field-level three-way merge)
  syncRevision        Int       @default(0)
  lastSyncedSnapshot  Json?     // Baseline snapshot with per-field values + hashes for 3-way merge
  conflictPayload     Json?     // Per-field conflict data when only some fields conflict

  post               Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([shopifyArticleId])
}

model ArticleSyncLog {
  id               Int      @id @default(autoincrement())
  shopId           Int
  postId           Int?
  shopifyArticleId String?
  direction        String   // app_to_shopify | shopify_to_app | reconcile
  eventType        String   // create | update | delete | publish | unpublish | webhook
  status           String   // applied | skipped_echo | skipped_duplicate | conflict | error
  message          String?  @db.Text
  localHash        String?
  remoteHash       String?
  payload          Json?
  createdAt        DateTime  @default(now())

  @@index([shopId])
  @@index([postId])
  @@index([createdAt])
}

model Template {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  thumbnail   String?
  blocks      Json
  source      String   @default("template") // "template" | "pattern"
  shopId      Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([source])
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  shopId    Int
  topic     String
  payload   Json?
  status    String   @default("received")
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([topic])
}

model PostAnalytic {
  id              Int      @id @default(autoincrement())
  postId          Int
  views           Int      @default(0)
  uniqueVisitors  Int      @default(0)
  addToCart       Int      @default(0)
  checkouts       Int      @default(0)
  conversions     Int      @default(0)
  revenue         Float    @default(0)
  // revenueUsd is the sum of each individual conversion's amount already converted to USD at
  // write-time (via ExchangeRateService) — safe to sum across shops/currencies. `revenue` stays
  // the raw (mixed-currency) total, kept for per-shop display where the shop's own currency is
  // known from context. lastCurrency is the most recently seen order currency for this
  // post/day, informational only — never used in aggregation math.
  revenueUsd      Float    @default(0)
  lastCurrency    String?
  deviceDesktop   Int      @default(0)
  deviceMobile    Int      @default(0)
  deviceTablet    Int      @default(0)
  sources         Json?
  countries       Json?
  date            DateTime @db.Date
  createdAt       DateTime @default(now())

  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date])
  @@index([postId])
  @@index([date])
}

// Persists the per-post-per-day unique-visitor dedup that used to live only in an in-process
// Map (global.__trackedVisitors) — that reset on every restart/deploy and couldn't be shared
// across horizontally-scaled instances, silently inflating "unique visitors" in production.
// A row existing for (postId, date, visitorHash) means that visitor was already counted that day.
model AnalyticsVisitor {
  id          Int      @id @default(autoincrement())
  postId      Int
  date        DateTime @db.Date
  visitorHash String
  createdAt   DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date, visitorHash])
  @@index([postId, date])
}

// Idempotency guard for the orders/create webhook (server-side conversion tracking) — Shopify
// webhook delivery is at-least-once, so the same order can be redelivered after a timeout or a
// transient non-2xx response. Insert-then-catch-P2002 before processing, same pattern already
// used for AnalyticsVisitor/PostAnalytic writes above.
model ProcessedOrderWebhook {
  id        Int      @id @default(autoincrement())
  shopId    Int
  orderId   String
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  shopId    Int
  rating    Int?
  topic     String?  @db.VarChar(120)
  message   String   @db.Text
  page      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model StoreLog {
  id        Int      @id @default(autoincrement())
  shopId    Int
  log       String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  recipientEmail  String
  recipientDomain String?
  subject         String
  body            String?  @db.Text
  template        String?
  status          String   @default("sent")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminActivityLog {
  id         Int      @id @default(autoincrement())
  action     String
  targetType String?
  targetId   Int?
  meta       Json?
  createdAt  DateTime @default(now())
}

model AdminSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopPlanOverride {
  id           Int       @id @default(autoincrement())
  shopDomain   String    @unique
  overridePlan String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SubscriptionPlan {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  title       String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  interval    String   @default("EVERY_30_DAYS")
  trialDays   Int      @default(0)
  description String?  @db.Text
  features    Json?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  couponPlans CouponPlan[]
}

// ── Billing Coupons — SaaS subscription discount codes ─────────────────────
// Applied to a merchant's subscription to THIS app via Shopify's real Billing API
// (appSubscriptionCreate's discount field), not a storefront/customer discount. A discount can
// only ever be attached at appSubscriptionCreate time — Shopify's own billing engine owns the
// discount's clock after that, so there is no "edit a live subscription's discount" concept here.
model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(40)
  discountType   String   @default("PERCENTAGE") @db.VarChar(20) // PERCENTAGE | FIXED_AMOUNT
  percentOff     Decimal? @db.Decimal(5, 2)
  amountOff      Decimal? @db.Decimal(10, 2)
  durationMonths Int
  description    String?  @db.Text
  active         Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  totalUses      Int?                                               // null = unlimited
  usesPerStore   Int      @default(1)
  appliesTo      String   @default("ALL_PAID_PLANS") @db.VarChar(20) // ALL_PAID_PLANS | SPECIFIC_PLANS | SPECIFIC_STORES
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  plans          CouponPlan[]
  shops          CouponShop[]
  claims         CouponClaim[]
}

model CouponPlan {
  id       Int              @id @default(autoincrement())
  couponId Int
  coupon   Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  planId   Int
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([couponId, planId])
}

model CouponShop {
  id         Int    @id @default(autoincrement())
  couponId   Int
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  shopDomain String

  @@unique([couponId, shopDomain])
}

model CouponClaim {
  id                  Int      @id @default(autoincrement())
  couponId            Int?
  coupon              Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // Snapshot of the coupon's code at claim time — CouponsModule.jsx's own delete-confirmation
  // copy already promises "those merchants keep their existing discount; this only stops new
  // claims", i.e. deleting a Coupon definition was always meant to leave claim history intact,
  // not destroy it. couponId alone can't do that (once the Coupon row is gone, `coupon.code`
  // becomes unreachable through the relation) — this field is what actually lets the admin
  // panel's usage table keep showing which code was used after the coupon itself is deleted.
  couponCode          String   @db.VarChar(40)
  // Same reasoning as couponCode — durationMonths is read from the live coupon relation
  // (superAdmin.js's usage listing) to compute total discounted revenue and when a claim's
  // discount period ends. Snapshotting it here means that calculation still works correctly for
  // claims whose coupon has since been deleted, instead of throwing on a null relation.
  couponDurationMonths Int
  shopDomain          String
  planTier            String   // SubscriptionPlan.name, matching how Shop.planKey is stored
  priceBeforeDiscount Decimal  @db.Decimal(10, 2)
  discountedPrice     Decimal  @db.Decimal(10, 2)
  currencyCode        String   @db.VarChar(10)
  status              String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | DECLINED | CANCELLED | EXPIRED
  shopifyChargeId     String   @unique
  createdAt           DateTime @default(now())

  @@index([shopDomain])
  @@index([couponId])
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   @db.Text
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
